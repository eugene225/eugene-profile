{
  "manifest_version": 3,
  "name": "퇴근시켜주세요",
  "version": "2.2.2",
  "x_last_updated": "2026-10-09",
  "description": "오늘 몇 시간 부족한지, 언제 퇴근하면 되는지 바로 알려드려요.",
  "action": {
    "default_title": "퇴근시켜주세요",
    "default_icon": {
      "16": "icons/clock-16.png",
      "32": "icons/clock-32.png",
      "48": "icons/clock-48.png",
      "128": "icons/clock-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "https://workplace.worksmobile.com/*"
  ],
  "commands": {
    "run-work-clock": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "근무시간 계산기 실행"
    }
  },
  "icons": {
    "16": "icons/clock-16.png",
    "32": "icons/clock-32.png",
    "48": "icons/clock-48.png",
    "128": "icons/clock-128.png"
  }
}
