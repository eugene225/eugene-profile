{
  "manifest_version": 3,
  "name": "GitHub PR Creator",
  "version": "0.2.0",
  "description": "Create GitHub pull requests quickly.",
  "action": {
    "default_title": "Create PR",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/dev-16.png",
      "32": "icons/dev-32.png",
      "48": "icons/dev-48.png",
      "128": "icons/dev-128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://api.haengbokza.site/*"
  ],
  "icons": {
    "16": "icons/dev-16.png",
    "32": "icons/dev-32.png",
    "48": "icons/dev-48.png",
    "128": "icons/dev-128.png"
  }
}
